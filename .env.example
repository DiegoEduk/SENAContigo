# SENAContigo Environment Configuration Example
PROJECT_NAME="SENAContigo API"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true

# Database
DATABASE_URL="postgresql+asyncpg://postgres:postgrespassword2026@localhost:5432/senacontigo"

# Redis
REDIS_URL="redis://localhost:6379/0"

# Security
SECRET_KEY="CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET_KEY_IN_PRODUCTION"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000","*"]
